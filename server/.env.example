# ---- Core (required) ----
MONGODB_URI=mongodb://127.0.0.1:27017/zipkart_logistics
# Use a long, random string. The server refuses to start in production with the example value.
JWT_SECRET=change-this-to-a-long-random-string

# ---- Server ----
PORT=4000
NODE_ENV=development
# Token lifetime and password hashing cost (optional overrides)
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Max request body size (document uploads); e.g. 10mb
JSON_BODY_LIMIT=10mb

# ---- CORS ----
# Primary frontend origin allowed to send cookies.
CLIENT_URL=http://localhost:5173
# Optional extra allowed origins, comma-separated (e.g. your deployed frontend URL).
CORS_ORIGINS=

# ---- Rate limiting (optional; sensible defaults) ----
# Global safety-net: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS (ms) per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
# Login brute-force guard.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- File storage (Cloudflare R2 / AWS S3) ----
# Leave blank to keep the inline base64 fallback. Set all of BUCKET + ACCESS_KEY + SECRET to enable.
# For Cloudflare R2, S3_ENDPOINT looks like https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL where stored files are served (R2 public bucket / custom domain / CDN).
S3_PUBLIC_URL=

# ---- First-admin bootstrap (used by: npm run seed:admin) ----
# This is a single-company app with no public registration; seed the first admin here.
COMPANY_NAME=My Company
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true to reset the admin password if the account already exists.
SEED_RESET_PASSWORD=false
